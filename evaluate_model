import pandas as pd
from sklearn.metrics import mean_absolute_error

# Load predictions
df = pd.read_csv("model_predictions.csv")

# Overall prediction error
mae = mean_absolute_error(df["finish_pos"], df["predicted_finish"])

print("\nModel Evaluation ->")
print(f"Overall MAE: {mae:.2f}")


# Round predictions to nearest finishing position
df["predicted_position"] = df["predicted_finish"].rank(method="first").astype(int)
df["predicted_position"] = df["predicted_position"].clip(lower=1)


# Podium accuracy
actual_podium = df["finish_pos"] <= 3
predicted_podium = df["predicted_position"] <= 3

podium_accuracy = (actual_podium & predicted_podium).sum() / actual_podium.sum()

print(f"Podium accuracy: {podium_accuracy:.2%}")


# Winner accuracy
actual_winner = df["finish_pos"] == 1
predicted_winner = df["predicted_position"] == 1

winner_accuracy = (actual_winner & predicted_winner).sum() / actual_winner.sum()

print(f"Winner accuracy: {winner_accuracy:.2%}")


# Error for each race
race_errors = df.groupby(["year", "track"]).apply(
    lambda race: mean_absolute_error(race["finish_pos"], race["predicted_finish"]),
    include_groups=False
)

print("\nMAE by race:")
print(race_errors)


# Best races
print("\nBest predictions:")
print(race_errors.sort_values().head(5))


# Worst races
print("\nWorst predictions:")
print(race_errors.sort_values(ascending=False).head(5))


# Individual predictions
print("\nPredictions:")

print(
    df[["year", "track", "driver", "finish_pos", "predicted_finish", "predicted_position"]]
    .sort_values(["year", "track", "predicted_position"])
    .to_string(index=False)
)